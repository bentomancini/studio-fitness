# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# A chave anon é pública (fica no navegador) e é protegida pelo RLS no banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# ID (UUID) do usuário dono no Supabase (Auth > Users). Só do servidor.
# É com ele que o app confirma que quem logou é o dono.
DONO_USER_ID=SEU_UUID_DE_USUARIO